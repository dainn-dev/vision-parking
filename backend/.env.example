# --- Core ---
APP_NAME="Vehicle Governance Platform API"
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

# Database (asyncpg). SSL for managed Postgres: append ?ssl=require
# The app runs as vmp_app (least-privileged, bound by FORCE RLS);
# migrations/DDL use ALEMBIC_DATABASE_URL (the postgres superuser).
DATABASE_URL=postgresql+asyncpg://vmp_app:vmp_app_dev_password@localhost:5432/vision_parking
ALEMBIC_DATABASE_URL=postgresql+asyncpg://vmp:vmp_dev_password@localhost:5432/vision_parking

# Redis (cache, realtime pub/sub, arq queue, rate limiting)
REDIS_URL=redis://localhost:6379/0

# --- Security ---
# CHANGE ME in production: openssl rand -hex 32
SECRET_KEY=change-me-in-production-0123456789abcdef0123456789abcdef
# Fernet key for encrypting TOTP secrets at rest: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
TOTP_ENCRYPTION_KEY=dev-only-fernet-key-replace-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false
COOKIE_DOMAIN=
COOKIE_SAMESITE=lax

# --- MQTT / EMQX ---
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_PREFIX=vmp-api

# --- S3 / MinIO ---
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin_dev
S3_BUCKET=vision-parking
S3_REGION=us-east-1
S3_SECURE=false
PLATE_IMAGE_RETENTION_DAYS=90

# --- SMTP / Mailpit ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@vehicle.platform.internal
SMTP_FROM_NAME="Platform Governance Control Center"
SMTP_STARTTLS=false

# --- Platform ---
PLATFORM_NAME="Vehicle Governance Platform"
PUBLIC_BASE_URL=http://localhost:8000
# Seed credentials for the bootstrap platform admin (only used on first migrate --seed)
SEED_ADMIN_EMAIL=anh.nh@kyanon.digital
SEED_ADMIN_PASSWORD=ChangeMe!2026
SEED_TENANT_PASSWORD=TenantDemo!2026
